  },
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/media": "4.0.547",
    "remotion": "4.0.547",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pretendard": "1.3.9",
    "@fontsource/noto-serif-kr": "5.2.8",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/qrcode": "1.5.5",
    "typescript": "5.9.3"
  }
}
